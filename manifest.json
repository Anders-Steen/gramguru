{
  "manifest_version": 3,
  "name": "GramGuru 🧐",
  "version": "0.1.0",
  "description": "Turns Norwegian recipe units (ss, ts, dl, kopp ...) into grams. Metric only — no imperial survivors.",
  "homepage_url": "https://github.com/anderss/gramguru",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GramGuru 🧐",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "scripts": ["dist/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "gramguru@anderss",
      "strict_min_version": "115.0"
    }
  }
}
