# AMO (addons.mozilla.org) API credentials for scripts/publish.js / upload-media.js
# Generate at: https://addons.mozilla.org/developers/addon/api/key/
AMO_API_KEY=
AMO_API_SECRET=
# Add-on slug or GUID to publish (as shown in the AMO Developer Hub URL).
AMO_ADDON_ID=
# Slug to use when the script creates a brand-new listing (default: gramguru).
AMO_SLUG=gramguru
